# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-me

# Gemini API key (use the paid tier before non-owner users; see ADR 0001).
GEMINI_API_KEY=replace-me

# Exact pinned Gemini model ID, chosen in Phase 6 from current Google docs.
GEMINI_MODEL=replace-me

# Optional Gemini runtime and quota controls (defaults shown).
# GEMINI_TIMEOUT_SECONDS=15.0
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_USER_DAILY_CAP=30
# GEMINI_GLOBAL_DAILY_CAP=200

# PostgreSQL connection URL (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://crypto_chatbot:replace-me@localhost:5432/crypto_chatbot

# Comma-separated Telegram numeric user IDs allowed during closed beta.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Per-user Telegram request rate limit per minute (default shown).
# RATE_LIMIT_PER_MINUTE=10
