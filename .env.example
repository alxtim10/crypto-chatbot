# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=replace-me

# Gemini API key.
GEMINI_API_KEY=replace-me

# Exact pinned Gemini model ID (e.g. gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini runtime and quota controls (defaults shown).
# GEMINI_TIMEOUT_SECONDS=15.0
# GEMINI_MAX_OUTPUT_TOKENS=1024
# GEMINI_USER_DAILY_CAP=30
# GEMINI_GLOBAL_DAILY_CAP=200

# PostgreSQL connection URL (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://crypto_chatbot:replace-me@localhost:5432/crypto_chatbot

# Comma-separated Telegram numeric user IDs allowed to interact with the bot.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Per-user sliding-window rate limit (commands per minute).
# RATE_LIMIT_PER_MINUTE=10

# Optional TradingView webhook secret & port (Phase 10).
# TRADINGVIEW_WEBHOOK_SECRET=
# TRADINGVIEW_WEBHOOK_PORT=443

# Optional ML inference mode: off | shadow | active (Phase 13).
# ML_INFERENCE_MODE=off

# Perpetual futures public data exchange: binance | gate | bingx
# Use 'gate' or 'bingx' if fapi.binance.com is blocked by your ISP.
# FUTURES_EXCHANGE=binance
# Comma-separated fallback exchanges tried in order if primary fails or symbol is unavailable.
# FUTURES_EXCHANGE_FALLBACKS=bingx,binance
